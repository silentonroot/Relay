# Agent Access Broker: broker API configuration template.
#
# Copy to `.env` (git-ignored) and fill in the blanks. Nothing in this file is a usable
# secret, and nothing sensitive has a default: a blank value must be set before the API
# will start.
#
# Synthetic data only. Do not point this at company systems or real third-party accounts.

# --- Database ---------------------------------------------------------------------------

# PostgreSQL connection string. It embeds the database password, so treat the whole value
# as a secret. Format (replace the bracketed parts, URL-encode the password):
#   postgres://aab:<password>@127.0.0.1:5432/aab
DATABASE_URL=

# --- HTTP listener ----------------------------------------------------------------------

# Interface to bind. Keep the loopback default unless a reverse proxy on another host
# needs to reach the API.
AAB_HOST=127.0.0.1

# TCP port. The dashboard's dev server proxies /v1 to this port.
AAB_PORT=4000

# Set to true only when the API sits behind a reverse proxy you control that overwrites
# X-Forwarded-For. When true, rate limiting uses the forwarded client address.
AAB_TRUST_PROXY=false

# --- Vault key material (browser worker only) -------------------------------------------

# Absolute path of a directory holding key-encryption keys, one file per version: kek-v1.key,
# kek-v2.key, ... The directory must be mode 0700 and each file mode 0600; the worker checks
# this at startup. Keep it outside this repository and outside the database, and back it up
# separately: without it, stored sessions cannot be decrypted and every connection must sign
# in again. Create the first key with the worker's `init-kek` command. The API refuses to start
# if this is set in its environment. Docker Compose does not mount or set it.
# Example: /home/<you>/.config/aab/keys
AAB_KEK_DIR=

# --- Dashboard sessions -----------------------------------------------------------------

# Lifetime of a dashboard login session, in minutes.
AAB_SESSION_TTL_MINUTES=480

# Mark the session cookie Secure. Leave true. Set false only for plain-HTTP development
# on a loopback address, where browsers would otherwise drop the cookie.
AAB_COOKIE_SECURE=true

# --- Logging ----------------------------------------------------------------------------

# One of: fatal, error, warn, info, debug, trace. Logs are structured JSON on stdout and
# never include credentials, cookies or tokens at any level.
AAB_LOG_LEVEL=info

# Password hashing costs about 128 MiB of memory per verification. These bound how many run at
# once and how many logins may wait; beyond that the API answers 429. Size the host or container
# memory for AAB_PASSWORD_CONCURRENCY x 128 MiB on top of the service's normal footprint.
AAB_PASSWORD_CONCURRENCY=2
AAB_PASSWORD_QUEUE_LIMIT=8

# How long POST /v1/operations/execute and /auth/complete wait for the worker before answering
# 202 with a job to poll, in milliseconds (0 to 120000).
AAB_JOB_WAIT_MS=20000

# --- Browser worker (services/browser-worker) -------------------------------------------
# The worker is a separate process with its own environment. It needs DATABASE_URL, AAB_LOG_LEVEL
# and the variables below. It is the only process that reads AAB_KEK_DIR in this phase: do not
# set AAB_KEK_DIR for the API.

# How each job is isolated. `bubblewrap` (default) needs the bubblewrap package and unprivileged
# user namespaces. `docker` needs access to a container engine and the aab/browser-runner image,
# runs Chromium with its own sandbox off inside the container, and does not support the sign-in
# window, so a docker-only worker cannot connect a new account. `unsafe-process` runs jobs with no isolation at all and is for development only: none
# of the documented security claims apply to it.
# AAB_WORKER_SANDBOX=bubblewrap

# Jobs run at once. Each one starts its own browser (roughly 300 to 500 MiB).
# AAB_WORKER_CONCURRENCY=2

# How often the worker looks for new jobs, and how long a claimed job stays reserved before
# another worker may recover it, in milliseconds.
# AAB_WORKER_POLL_MS=1000
# AAB_WORKER_LEASE_MS=60000

# Chromium binary used inside the sandbox.
# AAB_CHROMIUM_PATH=/usr/lib/chromium/chromium

# Short, private directory for per-job sockets. Defaults to $XDG_RUNTIME_DIR/aab-worker. Unix
# socket paths are limited to about 100 bytes, so keep this short.
# AAB_WORKER_RUNTIME_DIR=

# Sanitized results are removed from the database after this many minutes.
# AAB_JOB_RESULT_TTL_MINUTES=60

# --- Owner account ----------------------------------------------------------------------

# There is deliberately no variable for the owner's password. Create the first owner with
# the interactive `create-owner` command, which prompts on the terminal.

# --- Docker Compose only (infra/compose.yaml) -------------------------------------------
# These are read by Compose on the host, not by the API. Export them in your shell or pass
# them with `docker compose --env-file`. Paths are absolute and outside the repository.
#
# Compose also forwards AAB_SESSION_TTL_MINUTES, AAB_COOKIE_SECURE and AAB_LOG_LEVEL from
# the same source. Its AAB_COOKIE_SECURE default is false (plain HTTP on loopback); if you
# pass this file to Compose, the `true` above would apply and browsers would drop the
# cookie over HTTP. Use a separate env file for Compose, or edit that line.
# DATABASE_URL for Compose lives in `broker-api.env` and uses the host name `postgres`.

# Host directory holding two files you create locally: `postgres_password` and
# `broker-api.env` (containing DATABASE_URL). See README.md.
# AAB_HOST_SECRETS_DIR=

# uid and gid the API container runs as.
# AAB_UID=1000
# AAB_GID=1000

# Loopback port the dashboard is published on. If you change it, also change the allowed
# Host values in infra/docker/nginx/default.conf (see README.md).
# AAB_DASHBOARD_PORT=8080
